{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoniMesh",
  "version": "0.1.0",
  "identifier": "com.sonimesh.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SoniMesh",
        "width": 1240,
        "height": 860,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
