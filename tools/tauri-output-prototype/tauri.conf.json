{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoniMesh Output Probe",
  "version": "0.1.0",
  "identifier": "com.sonimesh.output-prototype",
  "build": {
    "frontendDist": "../../apps/desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "SoniMesh Output Probe",
      "url": "probe.html",
      "width": 1200,
      "height": 800,
      "minWidth": 700,
      "minHeight": 500
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
